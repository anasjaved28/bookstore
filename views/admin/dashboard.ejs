<% layout('layouts/boilerplate') -%>

<div class="container" id="admin-gate">
  <section id="dashboard-section">
    <h2 style="margin-bottom:1rem;">Sales Dashboard</h2>
    <div class="grid" id="stats-grid" style="margin-bottom:2rem;">
      <div class="card"><h3>Total Sales</h3><div class="price">₹<%= stats.totalSales.toFixed(2) %></div></div>
      <div class="card"><h3>Total Orders</h3><div class="price"><%= stats.totalOrders %></div></div>
      <div class="card">
        <h3>Top Sellers</h3>
        <ul>
          <% if (stats.topBooks.length === 0) { %>
            <li>No sales yet</li>
          <% } else { %>
            <% stats.topBooks.forEach(b => { %>
              <li><%= b.title %> — <%= b.quantity %> sold</li>
            <% }) %>
          <% } %>
        </ul>
      </div>
    </div>
  </section>

  <section id="add-book-section">
    <h2 style="margin-bottom:1rem;">Add a Book</h2>
    <form class="stacked" action="/books" method="POST">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" required>

      <label for="author">Author</label>
      <input type="text" id="author" name="author" required>

      <label for="category">Category</label>
      <input type="text" id="category" name="category" required>

      <label for="price">Price (₹)</label>
      <input type="number" id="price" name="price" min="0" step="0.01" required>

      <label for="stock">Stock</label>
      <input type="number" id="stock" name="stock" min="0" step="1" required>

      <label for="imageUrl">Cover Image URL (optional)</label>
      <input type="url" id="imageUrl" name="imageUrl">

      <label for="description">Description</label>
      <textarea id="description" name="description" rows="2"></textarea>

      <button type="submit" class="primary">Add Book</button>
    </form>
  </section>

  <section id="manage-books-section" style="margin-top:2.5rem;">
    <h2 style="margin-bottom:1rem;">Manage Inventory</h2>
    <table id="books-table">
      <thead>
        <tr><th>Title</th><th>Author</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% books.forEach(b => { %>
          <tr>
            <td><%= b.title %></td>
            <td><%= b.author %></td>
            <td><%= b.category %></td>
            <td>
              <form action="/books/update/<%= b._id %>" method="POST" style="display:flex; gap:5px;">
                <input type="number" name="price" value="<%= b.price %>" min="0" step="0.01" style="width:80px;">
            </td>
            <td>
                <input type="number" name="stock" value="<%= b.stock %>" min="0" step="1" style="width:70px;">
            </td>
            <td>
                <button type="submit" class="secondary" style="padding:0.3rem 0.6rem;">Save</button>
              </form>
              <form action="/books/delete/<%= b._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this book?');">
                <button type="submit" class="secondary" style="background:#b3261e; padding:0.3rem 0.6rem; margin-top:4px;">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>

  <section id="all-orders-section" style="margin-top:2.5rem;">
    <h2 style="margin-bottom:1rem;">All Orders</h2>
    <table id="orders-table">
      <thead>
        <tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>#<%= o._id.toString().slice(-6) %></td>
            <td><%= o.customer ? o.customer.name : 'Unknown' %></td>
            <td>₹<%= o.totalAmount.toFixed(2) %></td>
            <td><%= o.status %></td>
            <td><%= new Date(o.createdAt).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</div>